{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProjectObjects",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::depi-security-part4-demo-83921",
      "Condition": {
        "ForAnyValue:StringLike": {
          "s3:prefix": [
            "incoming/*",
            "reports/*"
          ]
        }
      }
    },
    {
      "Sid": "UploadNewCSVOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::depi-security-part4-demo-83921/incoming/*"
    },
    {
      "Sid": "ReadSanitizedReportsOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::depi-security-part4-demo-83921/reports/*"
    },
    {
      "Sid": "ReadBucketSecuritySettings",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPublicAccessBlock",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketVersioning",
        "s3:GetBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::depi-security-part4-demo-83921"
    },
    {
      "Sid": "ReadDashboardMonitoring",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UseProjectKMSKeyViaS3",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": "REPLACE-WITH-YOUR-KMS-KEY-ARN",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.us-east-1.amazonaws.com"
        }
      }
    }
  ]
}
